<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	App Sandbox is OFF - Mountain is a code editor that must read/write files
	anywhere the user picks. Hardened-runtime exemptions:
	  allow-jit + allow-unsigned-executable-memory  : Cocoon (Node.js) V8 JIT
	  allow-dyld-environment-variables              : extension helper binaries (DYLD_*)
	  disable-library-validation                    : unsigned npm-native dylibs (esbuild, sharp)
	  automation.apple-events                       : `osascript` from extensions (Reveal in Finder)
	NOTE: codesign / AMFIUnserializeXML rejects XML comments inside <dict>.
	Keep all comments in this outer wrapper only.
-->
<plist version="1.0">
	<dict>
		<key>com.apple.security.app-sandbox</key>
		<false />
		<key>com.apple.security.cs.allow-jit</key>
		<true />
		<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
		<true />
		<key>com.apple.security.cs.allow-dyld-environment-variables</key>
		<true />
		<key>com.apple.security.cs.disable-library-validation</key>
		<true />
		<key>com.apple.security.automation.apple-events</key>
		<true />
	</dict>
</plist>
