{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"windows": ["*"],
	"urls": [
		"http://localhost:*",
		"http://localhost:*/",
		"http://localhost:*/*",
		"https://tauri.localhost",
		"https://tauri.localhost/*",
		"tauri://localhost",
		"tauri://localhost/*"
	],
	"remote": {
		"urls": ["http://localhost:*", "http://localhost:*/*"]
	},
	"permissions": [
		"core:path:default",
		"core:event:default",
		"core:event:allow-listen",
		"core:event:allow-emit",
		"core:event:allow-emit-to",
		"core:window:default",
		"core:window:allow-is-fullscreen",
		"core:window:allow-is-maximized",
		"core:app:default",
		"core:image:default",
		"core:resources:default",
		"core:menu:default",
		"core:tray:default",
		"dialog:default",
		"dialog:allow-open",
		"dialog:allow-save",
		"dialog:allow-message",
		"fs:default",
		"fs:allow-read",
		"fs:allow-write",
		"log:default",
		"default"
	]
}
